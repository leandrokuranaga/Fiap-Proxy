{
  "ReverseProxy": {
    "Routes": {
      /* AUTH */
      "auth-login": {
        "ClusterId": "crm",
        "RateLimiterPolicy": "customPolicy",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },

      /* USERS */
      "users-create": {
        "ClusterId": "crm",
        "RateLimiterPolicy": "customPolicy",
        "Match": {
          "Path": "/api/v1/users/create",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },
      "users-usersgames": {
        "ClusterId": "crm",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "RateLimiterPolicy": "customPolicy",
        "Match": {
          "Path": "/api/v1/users/users-games",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "users-create-admin": {
        "ClusterId": "crm",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/users/create-admin",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },

      /* users por ID */
      "users-get-by-id": {
        "ClusterId": "crm",
        "Match": {
          "Path": "/api/v1/users/{id:int}",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "users-update": {
        "ClusterId": "crm",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/users/{id:int}",
          "Methods": [ "PATCH" ]
        },
        "Order": 0
      },
      "users-delete": {
        "ClusterId": "crm",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/users/{id:int}",
          "Methods": [ "DELETE" ]
        },
        "Order": 0
      },
      "users-list": {
        "ClusterId": "crm",
        "Match": {
          "Path": "/api/v1/users",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },

      /* GAMES */
      "games-create": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/games",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },
      "games-list": {
        "ClusterId": "fcg",
        "Match": {
          "Path": "/api/v1/games",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "games-get-by-id": {
        "ClusterId": "fcg",
        "Match": {
          "Path": "/api/v1/games/{id:int}",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "games-popular": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": {
          "Path": "/api/v1/games/popular",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "games-user-recommendations": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": {
          "Path": "/api/v1/games/recommendations/user/{id:int}",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },
      "games-search": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": {
          "Path": "/api/v1/games/search",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },

      /* PROMOTIONS */
      "promotions-create": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/promotions",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },
      "promotions-update": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/promotions/{id:int}",
          "Methods": [ "PATCH" ]
        },
        "Order": 0
      },
      "promotions-get-by-id": {
        "ClusterId": "fcg",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/promotions/{id:int}",
          "Methods": [ "GET" ]
        },
        "Order": 0
      },

      /* PAYMENTS */
      "payments-process": {
        "ClusterId": "payment",
        "RateLimiterPolicy": "customPolicy",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": {
          "Path": "/api/v1/payments",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },

      /* WEBHOOK */
      "webhook-stripe": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/webhook/stripe",
          "Methods": [ "POST" ]
        },
        "Order": 0
      },

      /* CATCH-ALLs */
      "auth-catchall": {
        "ClusterId": "crm",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "Order": 100
      },
      "users-catchall-admin": {
        "ClusterId": "crm",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": { "Path": "/api/v1/users/{**catch-all}" },
        "Order": 100
      }
    },

    "Clusters": {
      "crm": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": { "api1": { "Address": "https://localhost:7037/" } }
      },
      "fcg": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": { "games1": { "Address": "https://localhost:5001/" } }
      },
      "payment": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": { "pay1": { "Address": "https://localhost:7238/" } }
      }
    }
  },
  "ProxyObservability": {
    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "System": "Warning",
          "Yarp": "Information"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [Proxy] {Properties:j}{NewLine}{Exception}"
          }
        },
        {
          "Name": "GrafanaLoki",
          "Args": {
            "uri": "http://loki:3100",
            "labels": [
              {
                "key": "app-proxy",
                "value": "dotnet-api"
              },
              {
                "key": "env",
                "value": "docker"
              }
            ],
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
          }
        }
      ],
      "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
    },
    "DistributedTracing": {
      "Jaeger": {
        "ServiceName": "Proxy",
        "Host": "jaeger",
        "Endpoint": "http://jaeger:14268/api/traces",
        "Port": 6831
      }
    }
  },
  "AWS": {
    "Observability": {
      "ServiceName": "FiapProxy",
      "Region": "sa-east-1",
      "LocalStack": {
        "Enabled": true,
        "ServiceUrl": "http://localhost:4566"
      },
      "CloudWatch": {
        "Logs": {
          "Enabled": true,
          "LogGroup": "/fiap/proxy",
          "LogStreamPrefix": "proxy-"
        },
        "Metrics": {
          "Enabled": true,
          "Namespace": "Fiap/Proxy"
        }
      }
    }
  }
}
