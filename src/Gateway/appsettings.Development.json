{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "default": {
        "ClusterId": "fcgCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "fcgCluster": {
        "Destinations": {
          "fcgDestination": {
            "Address": "https://localhost:44323/"
          }
        }
      }
    }
  }
}