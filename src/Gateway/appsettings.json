{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "fcg": {
        "ClusterId": "fcgCluster",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/fcg/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/fcg" } ]
      },
      "crm": {
        "ClusterId": "crmCluster",
        "Match": {
          "Path": "/api/crm/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/crm" } ]
      },
      "payment": {
        "ClusterId": "paymentCluster",
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/payment" } ]
      }
    },
    "Clusters": {
      "fcgCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:5001" } },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true }
      },
      "crmCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7037" } },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true }
      },
      "paymentCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7238" } },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true }
      }
    }
  }
}