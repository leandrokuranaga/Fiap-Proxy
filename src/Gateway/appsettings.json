{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "games": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/v1/games/{**catch-all}"
        }
      },
      "promotions": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/v1/promotions/{**catch-all}"
        }
      },
      "createUsers": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/users/create"
        }
      },
      "usersGames": {
        "ClusterId": "api",
        "AuthorizationPolicy": "AnyAuthenticated",
        "Match": {
          "Path": "/api/v1/users/users-games"
        }
      },
      "users": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "api1": {
            "Address": "https://localhost:5001/"
          }
        }
      }
    }
  }
}